# Supabase Configuration
# Get these from your Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Environment
VITE_APP_ENV=development

# Messaging Services (for notifications) - V2
# VITE_WHATSAPP_API_KEY=your_whatsapp_api_key
# VITE_SMS_PROVIDER_KEY=your_sms_provider_key
# VITE_EMAIL_SERVICE_KEY=your_email_service_key

# Note: Always use the ANON key (not secret key) in frontend applications
# The secret key should only be used in backend/server environments